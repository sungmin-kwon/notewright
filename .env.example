# Copy this file to .env and fill it in. .env is in .gitignore and never committed.

# Mistral API key (console.mistral.ai → API keys).
MISTRAL_API_KEY=

# GitHub fine-grained token, only for the site repo, with
# Contents: read and write, Pull requests: read and write.
GITHUB_TOKEN=

# Optional. Port of the local web app (default 4318).
# PORT=4318
